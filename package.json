{
  "name": "lumen-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Local-first Markdown notes editor with a desktop shell and a shared rendering layer",
  "author": {
    "name": "Lumen Notes",
    "email": "noreply@lumen-notes.invalid"
  },
  "homepage": "https://lumen-notes.invalid/",
  "desktopName": "lumen-notes",
  "scripts": {
    "dev": "concurrently -k -n web,sync -c cyan,magenta \"vite --host 0.0.0.0\" \"node server/index.mjs\"",
    "dev:web": "vite --host 0.0.0.0",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "electron": "node electron/launch.cjs",
    "electron:build": "npm run build && node electron/launch.cjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "bash build-linux-all.sh",
    "dist:linux:rpm-setup": "LUMEN_SETUP_RPM=1 bash build-linux-all.sh",
    "dist": "npm run build && electron-builder --win --x64",
    "cap:sync": "npm run build && cap sync android",
    "apk:debug": "node scripts/build-android.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@codemirror/autocomplete": "^6.18.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.1",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
